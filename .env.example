# LLM (OpenAI-compatible chat: DeepSeek, OpenAI, Z.ai, etc.)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embeddings: local (sentence-transformers, free) or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_DIM=384
# Only set if EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Avoid HF tokenizer fork warnings
TOKENIZERS_PARALLELISM=false

# Postgres + pgvector
PG_DSN=postgresql://postgres:CHANGE_ME@localhost:5432/rag

# Graph store (sqlite-graph extension)
GRAPH_DB_PATH=data/graph.db
GRAPH_EXTENSION_PATH=vendor/libgraph.dylib

# Loop RAG
LOOP_MAX_ITERATIONS=4
LOOP_CONVERGENCE_THRESHOLD=0.15

# API
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_API_URL=http://localhost:8000
